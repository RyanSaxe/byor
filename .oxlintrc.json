{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // Pass an options object when a function needs more than three inputs.
    "max-params": ["error", { "max": 3 }],
    // Narrow with type guards or runtime checks instead of casting with `as`.
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "never" }
    ],
    // Use `unknown` and narrow instead of turning off checks with `any`.
    "typescript/no-explicit-any": "error",
    // Handle null and undefined explicitly instead of using `!`.
    "typescript/no-non-null-assertion": "error",
    // Cover every member of a discriminated union in switch statements.
    "typescript/switch-exhaustiveness-check": "error"
  },
  "overrides": [
    {
      // Ambient declarations mirror external APIs (such as node:child_process.execFile)
      // whose parameter count is fixed.
      "files": ["**/*.d.ts"],
      "rules": {
        "max-params": "off"
      }
    }
  ]
}
